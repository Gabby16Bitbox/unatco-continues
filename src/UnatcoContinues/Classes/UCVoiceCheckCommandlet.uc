// Generated by tools/voices/prepare_voice_check.py.
// Runs the compiled UnrealScript lookup against the audio package.
class UCVoiceCheckCommandlet extends Commandlet;

var int checked, failed;

function Check(int expected, string speaker, string text, bool bRadio)
{
    local int actual;
    local Sound snd;
    checked++;
    actual = class'UCVoice'.static.VoiceKey(speaker, text, bRadio);
    snd = class'UCVoice'.static.Find(text, speaker, bRadio);
    if (actual != expected || snd == None)
    {
        failed++;
        Log("UCVoiceCheck FAIL expected=V" $ expected $ " actual=V" $ actual $ " sound=" $ snd);
    }
}

