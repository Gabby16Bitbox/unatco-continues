    Check(7276741, "WaltonSimons", "Whatever else you found, don't let it distract you from the objective. Chow's activities can be reviewed after Tong is in custody.", True);
    Check(11352111, "WaltonSimons", "Locate Tracer Tong.", True);
    Check(8936092, "WaltonSimons", "Denton. I received your report on the Dragon's Tooth. Secure the weapon and continue your investigation.", True);
    Check(4591599, "WaltonSimons", "Maggie Chow is a Coalition intelligence asset. Assets sometimes withhold information when they believe it protects their position. That doesn't make everything they've provided useless.", True);
    Check(4604032, "WaltonSimons", "Don't lose sight of the assignment. Resolve the Triad situation and locate Tracer Tong. We'll review Chow afterward.", True);
    Check(13729488, "TracerTong", "J.C. Denton.", False);
    Check(2491107, "JCDenton", "Tracer Tong.", False);
    Check(11925030, "TracerTong", "Paul believed you would come here eventually. I don't think this is what he had in mind.", False);
    Check(4567245, "JCDenton", "Paul expected me to ask for your help.", False);
    Check(5709569, "TracerTong", "And instead you have orders to remove me.", False);
    Check(6354539, "JCDenton", "Identify your network first. Then take you out.", False);
    Check(8504549, "TracerTong", "A useful phrase. 'Take out.' It allows a bureaucrat to postpone deciding whether a man is a prisoner or a corpse.", False);
    Check(2442723, "JCDenton", "You're still here.", False);
    Check(12276412, "TracerTong", "Because you came to talk first.", False);
    Check(13544793, "JCDenton", "Paul says UNATCO is compromised.", False);
    Check(13816432, "TracerTong", "And you do not believe him.", False);
    Check(16075218, "JCDenton", "I believe he found evidence. I don't believe joining the NSF made the evidence more true.", False);
    Check(6427915, "TracerTong", "That is the difference between you and your brother. Paul reached the end of the argument before he showed you the beginning. He asked you to accept his conclusions because you trusted him.", False);
    Check(3483633, "JCDenton", "I don't.", False);
    Check(5189203, "TracerTong", "Good. Trust is useful between friends. It is a poor substitute for evidence.", False);
    Check(6866460, "JCDenton", "Then show me yours.", False);
    Check(10072727, "TracerTong", "Exactly.", False);
    Check(14689572, "TriadRedArrow", "Tong agreed to see you. That doesn't make you welcome.", False);
    Check(1610463, "TriadLumPath", "Tong agreed to see you. That doesn't make you welcome.", False);
    Check(1611533, "TriadRedArrow", "Keep your weapon down and there won't be a problem.", False);
    Check(7318196, "TriadLumPath", "Keep your weapon down and there won't be a problem.", False);
    Check(1285566, "TracerTong", "These are shipping records Paul obtained before he left UNATCO. Compare the identifiers with these.", False);
    Check(8024671, "JCDenton", "Same Ambrosia shipments.", False);
    Check(12236267, "TracerTong", "Rerouted through VersaLife subsidiaries. Here are the corresponding laboratory authorizations.", False);
    Check(411270, "JCDenton", "Nanotechnology.", False);
    Check(5096985, "TracerTong", "Restricted research, below the publicly listed facilities.", False);
    Check(12743176, "JCDenton", "This proves VersaLife is involved with the shipments. It doesn't prove UNATCO is.", False);
    Check(7901776, "TracerTong", "No. So keep looking.", False);
    Check(4197648, "JCDenton", "Why give this to me?", False);
    Check(11233172, "TracerTong", "Because Paul tried to change your allegiance. I'm interested in changing your information.", False);
    Check(5616260, "JCDenton", "What happened?", False);
    Check(9719192, "TracerTong", "Several armed teams just entered the upper compound. Coalition weapons, coordinated movement.", False);
    Check(5488976, "TracerTong", "Your friends.", False);
    Check(460517, "JCDenton", "UNATCO?", False);
    Check(1059165, "TracerTong", "You tell me.", False);
    Check(4743752, "TracerTong", "There is your answer.", False);
    Check(5550836, "JCDenton", "To what?", False);
    Check(2815520, "TracerTong", "Why they let you find me.", False);
    Check(8303593, "TracerTong", "They did not send you here because they trusted you to kill me. They sent you because I would allow Paul Denton's brother through a door I would close to any other UNATCO agent.", False);
    Check(1953963, "JCDenton", "They could have followed me from the market.", False);
    Check(4704246, "TracerTong", "And found another safehouse. Another basement. Another empty room.", False);
    Check(9676691, "TracerTong", "You were the authentication.", False);
    Check(13550104, "TracerTong", "Come with me.", False);
    Check(11331180, "JCDenton", "No.", False);
    Check(5048724, "TracerTong", "Then stay here.", False);
    Check(12620679, "TracerTong", "Paul wanted you to believe him. I don't.", False);
    Check(9215597, "TracerTong", "Watch what your people do.", False);
    Check(11390148, "JCDenton", "What are you doing?", False);
    Check(9339827, "MJ12Troop", "Sanitizing the network. Tong's people had access to restricted Coalition material.", False);
    Check(9201522, "JCDenton", "Those systems are evidence.", False);
    Check(13891281, "MJ12Troop", "Anything relevant has already been copied.", False);
    Check(9464054, "JCDenton", "By who?", False);
    Check(1875255, "MJ12Troop", "Special Projects.", False);
    Check(16503836, "JCDenton", "Hold your fire.", False);
    Check(10015323, "MJ12Commando", "He's part of Tong's technical staff.", False);
    Check(12855561, "JCDenton", "Then arrest him.", False);
    Check(14719260, "MJ12Commando", "We weren't instructed to process prisoners.", False);
    Check(16460102, "JCDenton", "You are now.", False);
    Check(12965096, "MJ12Commando", "Take him upstairs.", False);
    Check(6727178, "ScientistConsulting", "I'm unarmed! I'm not security!", False);
    Check(1268029, "MJ12Commando", "Agent Denton. Special Projects. We'll secure the facility from here.", False);
    Check(14278125, "JCDenton", "Tong is dead.", False);
    Check(4341988, "MJ12Commando", "Then his data is what matters. Your orders are to preserve any intelligence you recovered and stay clear of the sweep.", False);
    Check(3806339, "JCDenton", "Tong's moving through the rear section.", False);
    Check(12241519, "MJ12Commando", "Teams are covering the exits. Your orders are to preserve any intelligence you recovered and stay clear of the sweep.", False);
    Check(264183, "JCDenton", "Simons told me to secure the facility.", False);
    Check(10803427, "MJ12Commando", "Then we have compatible objectives.", False);
    Check(14906523, "MJ12Commando", "The facility is secure. The network, personnel and data are ours.", False);
    Check(11632523, "JCDenton", "Nobody told me that was the objective.", False);
    Check(1842824, "JCDenton", "Tong got out.", False);
    Check(3963225, "MJ12Commando", "The facility is secure.", False);
    Check(9170787, "JCDenton", "Tong was the objective.", False);
    Check(15108460, "MJ12Commando", "Tong was one objective. The network, personnel and data were the others.", False);
    Check(4146345, "JCDenton", "Nobody told me that.", False);
    Check(7059410, "MJ12Commando", "You weren't part of this operation until you found the door.", False);
    Check(590795, "MJ12Commando", "Stay clear of the sweep, Agent Denton.", False);
    Check(11843482, "WaltonSimons", "Denton. Hold your position. A Special Projects recovery team is entering the compound.", True);
    Check(2146271, "WaltonSimons", "Tong's death has been confirmed. Do not interfere with the sweep. Secure any intelligence you've already recovered and assist the team only if requested.", True);
    Check(14045263, "WaltonSimons", "Tong's location has been confirmed. Do not interfere with the sweep. Secure any intelligence you've already recovered and assist the team only if requested.", True);
    Check(1248603, "WaltonSimons", "You've completed the locating phase of your assignment.", True);
    Log("UCVoiceCheck: " $ checked $ " checked, " $ failed $ " failed.");
    if (failed != 0)
        return 1;
    return 0;
}

