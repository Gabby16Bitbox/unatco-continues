// Saved recipients in small chunks: UE1's text importer truncates long string fields.
// These helpers are generated by the editor, never visible or selectable in game.
class UCLinkGroup extends Info;
var() name Member[128];
var() name NextGroup;

function SetMember(int i, name value)
{
 if (i >= 0 && i < ArrayCount(Member)) Member[i] = value;
}

function name GetMember(int i)
{
 if (i < 0 || i >= ArrayCount(Member)) return '';
 return Member[i];
}

function UCLinkGroup Next()
{
 local UCLinkGroup G;
 if (NextGroup == '') return None;
 foreach AllActors(class'UCLinkGroup', G)
  if (G.Name == NextGroup && !G.bDeleteMe) return G;
 return None;
}

function bool Contains(name actorName)
{
 local UCLinkGroup G;
 local int i;
 G = Self;
 while (G != None)
 {
  for (i=0; G.GetMember(i) != ''; i++)
   if (G.GetMember(i) == actorName) return True;
  G = G.Next();
 }
 return False;
}

defaultproperties
{
 bHidden=True
 bStatic=False
}
