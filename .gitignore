# UNATCO Continues - cosa entra nel repository.
# Regola: e' escluso TUTTO, poi si riammette solo quello che e' della mod e si puo' pubblicare.
# Restano fuori: i file del gioco e di Revision (DevInstall, mappe .dx, SDK, editor), le voci
# registrate (audio, campioni, id delle voci), le chiavi dei servizi, le compilazioni, le foto
# di prova e le copie di sicurezza.
/*
!/.gitignore
!/README.md
!/PLAY.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/.gitattributes
!/*.ps1
!/*.bat

# codice della mod
!/src/
/src/*
!/src/UnatcoContinues/
/src/UnatcoContinues/*
!/src/UnatcoContinues/Classes/
!/src/UnatcoContinues/Textures/
!/src/UnatcoContinues/obsolete/

# documentazione
!/docs/
/docs/*
!/docs/NARRATIVE_DESIGN.md
!/docs/WORKFLOW.md
!/docs/STATUS.md
!/docs/CAMPAIGN_CONCEPT.md
!/docs/CAMPAIGN_REWRITE_2026_10_06.md
!/docs/tutorials/
!/docs/narrative/
!/docs/img/
!/docs/NOTE_DI_SVILUPPO.md
!/docs/ROUTE_DESIGN.md
!/docs/STORY.md
!/docs/MISSION1_PIANO.md
!/docs/HONGKONG_DESIGN.md
!/docs/HONGKONG_M1_PIANO.md
!/docs/HONGKONG_ASSAULT_DESIGN.md
!/docs/MURI_SOLO_UNATCO.md
!/docs/PLAYTEST_HK.md
!/docs/VIDEO_PRESENTAZIONE.md
!/docs/VOICES.md
!/docs/MISSION_SCRIPTS.md
/docs/narrative/TRAILER_SEEDANCE_*

# strumenti (solo script nostri: niente eseguibili, archivi, voci)
!/tools/
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/*.ahk
!/tools/editor_bridge/
/tools/editor_bridge/*
!/tools/editor_bridge/*.py
!/tools/editor_bridge/*.ps1
!/tools/editor_bridge/*.md
!/tools/editor_bridge/requirements.txt
/tools/editor_bridge/verify_bridge.py
/tools/editor_bridge/verify_geometry.py
/tools/editor_bridge/verify_trial.py
/tools/editor_bridge/GEOMETRY_RESULTS.md
!/tools/editor_bridge/examples/
!/tools/editor_bridge/editor_src/
!/tools/editor_bridge/engine_src/
/tools/editor_bridge/CLAUDE_HANDOFF.md
/tools/editor_bridge/configure_mcp.py
/tools/editor_bridge/server.py
/tools/editor_bridge/verify_editor.py
/tools/editor_bridge/requirements.txt
/tools/editor_bridge/verify_bridge.py
/tools/editor_bridge/verify_geometry.py
/tools/editor_bridge/verify_trial.py

# mappe: gli script delle modifiche e le PATCH delle mappe modificate dalla mod (14 ott 2026, Gabby:
# niente mappe di Revision nel repository, sono loro). Una patch ha solo le nostre differenze:
# install.ps1 la applica alla copia di Revision\Maps di chi installa (tools\mappatch.py).
!/maps/
/maps/*
!/maps/patches/
!/maps/patches.json
# the original game's (19 Oct 2026): the same, against the original Deus Ex's maps
!/maps/vanilla/
/maps/vanilla/*
!/maps/vanilla/patches/
!/maps/vanilla/patches.json
# the installers' scripts (Inno Setup); what they build goes to build\installer (not here)
!/installer/

# voci: niente (19 ott 2026, Gabby): ne' audio ne' gli strumenti, che lavorano su cloni delle voci del
# gioco. Come si potrebbero fare, a titolo informativo: docs/VOICES.md
/tools/voices/

# mai, da nessuna parte
__pycache__/
*.pyc
*.bak
*.bak-*
*.log
*.dx
*.u
*.wav
*.mp3
*.exe
*.dll
*.7z
*key*.txt
/src/UnatcoContinues/Textures/UCSignElevators*
# Eva's helicopter: the game's BlackHelicopterTex1 recoloured (tools\make_eva_heli_tex.py makes it)
/src/UnatcoContinues/Textures/UCEvaHeliTex*

# niente di Revision nel repository: nessuna mappa, texture o pacchetto loro (14 ott 2026)

# ...e per sicurezza, detto due volte: la chiave vera e gli id delle voci non entrano MAI
/tools/voices/*_key.txt
/tools/voices/voices.json
