# UNATCO Continues - cosa entra nel repository.
# Regola: e' escluso TUTTO, poi si riammette solo quello che e' della mod e si puo' pubblicare.
# Restano fuori: i file del gioco e di Revision (DevInstall, mappe .dx, SDK, editor), le voci
# registrate (audio, campioni, id delle voci), LA CHIAVE ElevenLabs, le compilazioni, le foto
# di prova e le copie di sicurezza.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/.gitattributes
!/*.ps1
!/*.bat

# codice della mod
!/src/
/src/*
!/src/UnatcoContinues/
/src/UnatcoContinues/*
!/src/UnatcoContinues/Classes/
!/src/UnatcoContinues/Textures/
!/src/UnatcoContinues/obsolete/

# documentazione
!/docs/
/docs/*
!/docs/NARRATIVE_DESIGN.md
!/docs/WORKFLOW.md
!/docs/STATUS.md
!/docs/tutorials/
!/docs/narrative/
!/docs/img/
!/docs/NOTE_DI_SVILUPPO.md
!/docs/ROUTE_DESIGN.md
!/docs/STORY.md
!/docs/MISSION1_PIANO.md
!/docs/HONGKONG_DESIGN.md
!/docs/HONGKONG_M1_PIANO.md
!/docs/HONGKONG_ASSAULT_DESIGN.md
!/docs/MURI_SOLO_UNATCO.md
!/docs/PLAYTEST_HK.md
!/docs/VIDEO_PRESENTAZIONE.md

# strumenti (solo script nostri: niente eseguibili, archivi, voci)
!/tools/
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/*.ahk
!/tools/editor_bridge/
/tools/editor_bridge/*
!/tools/editor_bridge/*.py
!/tools/editor_bridge/*.ps1
!/tools/editor_bridge/*.md
!/tools/editor_bridge/requirements.txt
/tools/editor_bridge/GEOMETRY_RESULTS.md
!/tools/editor_bridge/examples/
!/tools/editor_bridge/editor_src/
!/tools/editor_bridge/engine_src/

# mappe: gli script delle modifiche e le PATCH (differenze rispetto alla mappa originale,
# vedi tools/map_patch.py). Le mappe .dx no: sono copie modificate di quelle del gioco.
!/maps/
/maps/*
!/maps/editing/
!/maps/patches/

# voci: solo gli script e i piani di regia in uso. Niente audio, campioni, ricevute dei
# cloni, id delle voci (voices.json) e soprattutto niente chiave: al loro posto i due
# file .example da copiare e riempire.
!/tools/voices/
/tools/voices/*
!/tools/voices/*.py
!/tools/voices/voices.ps1
!/tools/voices/README.md
!/tools/voices/delivery_natural_v4.json
!/tools/voices/delivery_hk_draft_v4.json
!/tools/voices/mix_profile.json
!/tools/voices/timing_reviews.json
!/tools/voices/voices.example.json

# mai, da nessuna parte
__pycache__/
*.pyc
*.bak
*.bak-*
*.log
*.dx
*.u
*.wav
*.mp3
*.exe
*.dll
*.7z
*key*.txt

# segnaposto della chiave (dopo la regola qui sopra, che altrimenti lo escluderebbe)
!/tools/voices/elevenlabs_key.example.txt
# ...e per sicurezza, detto due volte: la chiave vera e gli id delle voci non entrano MAI
/tools/voices/elevenlabs_key.txt
/tools/voices/voices.json
